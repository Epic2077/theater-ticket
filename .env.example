# --- Supabase backend --------------------------------------------------------
# Copy this file to `.env` and fill in the values from your Supabase project
# dashboard (Project Settings → API).

# Public URL of your Supabase project, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Public "anon" publishable key.
VITE_SUPABASE_ANON_KEY=
VITE_SUPABSE_SERVICE_ROLE_KEY=

# --- Database init (npm run db:init) ----------------------------------------
# Your project ref (the 20-char id in the URL above). Used to link & push the
# schema to the hosted database. Leave empty to use a local Supabase stack
# (requires Docker) instead.
SUPABASE_PROJECT_REF=

SUPABASE_ACCESS_TOKEN=

# Set SUPABASE_LOCAL=true to force the local stack even when a ref is set.
SUPABASE_LOCAL=false
